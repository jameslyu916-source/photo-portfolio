---
import { languageTag } from "../../lib/i18n";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath: string;
}

const {
  title,
  description = "Personal photography portfolio exploring landscapes, streets, and the spaces in between.",
  image,
  canonicalPath,
} = Astro.props;

const site = Astro.site ?? new URL("https://jtimes-visual.com");

const swapLocale = (target: string) =>
  canonicalPath.replace(/\/(en|zh-cn)(\/|$)/, `/${target}$2`);

const canonicalURL = new URL(canonicalPath, site).href;
const enURL = new URL(swapLocale("en"), site).href;
const zhcnURL = new URL(swapLocale("zh-cn"), site).href;
const ogImage = image
  ? new URL(image, site).href
  : new URL("/social-preview.jpg", site).href;

// Astro does NOT interpolate expressions inside <script type="application/ld+json">
// — that content is emitted verbatim. Building the payload as a real string and
// injecting it with set:html is what keeps the JSON valid; a `{site}` placeholder
// in the template ships literally and every crawler rejects the block.
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "James Lyu",
  url: site.href,
  jobTitle: "Photographer",
  sameAs: [
    "https://www.instagram.com/jtimes.visual/",
    "https://www.threads.net/@jtimes.visual",
  ],
}).replace(/</g, "\\u003c");
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={enURL} />
<link rel="alternate" hreflang={languageTag("zh-cn")} href={zhcnURL} />
<link rel="alternate" hreflang="x-default" href={enURL} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={structuredData}></script>
