---
import { languageTag, type Locale } from "../../lib/i18n";

interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;

const targetLocale: Locale = currentLocale === "en" ? "zh-cn" : "en";
const targetLabel = targetLocale === "zh-cn" ? "中文" : "EN";

// Swap locale in the current path — keeps the base prefix intact.
// Paths without a locale segment (the 404 page) fall back to that locale's
// home, otherwise the switcher just links back to the page you are already on.
const isLocalized = /\/(en|zh-cn)(\/|$)/.test(currentPath);
const targetHref = isLocalized
  ? currentPath.replace(/\/(en|zh-cn)(\/|$)/, `/${targetLocale}$2`)
  : `/${targetLocale}/`;
---

<a
  href={targetHref}
  class="text-xs font-medium px-2.5 py-1 rounded-full border border-border
         text-muted hover:text-ink hover:border-ink transition-colors"
  hreflang={languageTag(targetLocale)}
  lang={languageTag(targetLocale)}
>
  {targetLabel}
</a>
