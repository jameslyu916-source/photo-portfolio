---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes: string;
  class?: string;
}

const { image, alt, widths = [400, 800, 1200], sizes, class: className } = Astro.props;
const fallbackWidth = Math.min(800, image.width);

const optimized = await getImage({
  src: image,
  width: fallbackWidth,
  widths: [...new Set(widths.map((width) => Math.min(width, image.width)))],
  format: "webp",
});

const placeholder = await getImage({
  src: image,
  width: 16,
  format: "webp",
});
---

<div class="overflow-hidden absolute inset-0">
  <img
    src={placeholder.src}
    alt=""
    width={optimized.attributes.width}
    height={optimized.attributes.height}
    class="blur-up w-full h-full object-cover absolute inset-0"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <img
    src={optimized.src}
    srcset={optimized.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={optimized.attributes.width}
    height={optimized.attributes.height}
    loading="lazy"
    decoding="async"
    class={`w-full h-full object-cover relative z-10 ${className ?? ""}`}
    onload="this.previousElementSibling.classList.add('loaded')" onerror="this.previousElementSibling.remove()"
  />
</div>
