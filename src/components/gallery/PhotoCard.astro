---
import type { Photo } from "../../lib/photos";
import LazyImage from "./LazyImage.astro";

interface Props {
  photo: Photo;
  delay?: number;
  sizes?: string;
}

const {
  photo,
  delay = 0,
  sizes = "(max-width: 380px) calc(100vw - 3rem), (max-width: 900px) calc(50vw - 1.6rem), (max-width: 1280px) calc(33.33vw - 1.17rem), 408px",
} = Astro.props;
const { image, title, location, series } = photo.data;
const slug = photo.id.split("/").pop()?.replace(".md", "");
---

<!-- No href: clicking is handled by FilmStrip's delegated listener. role+tabindex
     keep the card reachable by keyboard; Enter/Space is handled in FilmStrip. -->
<a
  class="group block cursor-zoom-in rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  data-photo-id={slug}
  data-series={series ?? ""}
  role="button"
  aria-label={title}
  tabindex="0"
  style={`aspect-ratio: ${image.width} / ${image.height}; animation-delay: ${delay}ms;`}
>
  <div class="relative overflow-hidden w-full h-full">
    <LazyImage
      image={image}
      alt={title}
      sizes={sizes}
      class="group-hover:scale-105 transition-transform duration-700 ease-out will-change-transform backface-hidden"
    />

    <div
      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/50 to-transparent
                  opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-500
                  flex flex-col justify-end p-5 pt-12 z-20 will-change-[opacity]"
    >
      {title && (
        <h3 class="text-white text-sm font-medium leading-snug">{title}</h3>
      )}
      {location && (
        <p class="text-white/70 text-xs mt-0.5 font-light">{location}</p>
      )}
    </div>
  </div>
</a>
